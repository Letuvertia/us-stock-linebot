# Google Service Account JSON file paths
DATA_CREDS_FILE=.secrets/data-creds.json
NEWS_CREDS_FILE=.secrets/news-creds.json

# Central Google Spreadsheet IDs
US_STOCK_SPREADSHEET_ID=your_us_stock_metadata_spreadsheet_id_here
USER_CONFIG_SPREADSHEET_ID=your_user_config_spreadsheet_id_here

# Optional: Google Apps Script Webhook Endpoint for local pipeline triggers
GAS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbx_your_gas_deployment_id_here/exec

# Market Data API Keys (comma-separated for round-robin)
FMP_API_KEY=your_fmp_api_key_1,your_fmp_api_key_2
FINNHUB_API_KEY=your_finnhub_api_key_1,your_finnhub_api_key_2
